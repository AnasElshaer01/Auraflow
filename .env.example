# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection string
# Local (docker-compose): postgresql://postgres:postgres@localhost:5432/auraflow
# Replit: injected automatically via DATABASE_URL secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auraflow

# Session signing secret — any random string works for local dev
SESSION_SECRET=change-me-to-a-random-secret
